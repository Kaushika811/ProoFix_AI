# Data source for the workspace.
#   mock -> reads the bundled fixtures in src/mocks (no backend required)
#   api  -> calls the ProoFix backend and streams the live agent timeline
VITE_DATA_SOURCE=mock

# Base URL for API calls. Leave EMPTY in development so requests go to the
# Vite dev proxy (same origin, no CORS). Set it for production deployments
# where the API lives on another host, e.g. https://api.example.com
VITE_API_BASE_URL=

# Backend the dev proxy forwards /api and /ws to.
VITE_BACKEND_ORIGIN=http://127.0.0.1:8000
