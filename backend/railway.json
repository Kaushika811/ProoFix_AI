{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r requirements.txt 'pytest>=8.3.0' 'pytest-json-report>=1.5.0'"
  },
  "deploy": {
    "startCommand": "PYTHONPATH=.. uvicorn main:app --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 300
  }
}
