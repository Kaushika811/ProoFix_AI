# ============================================================
# ProoFix Backend — Production Environment Variables
# ============================================================
# Copy to .env and fill in real values before running.

# ---- Pipeline Mode -----------------------------------------
# true  = development/test (patches are stubs, no LLM calls)
# false = production (requires a configured LLM provider below)
STUB_MODE=false

# ---- LLM Provider ------------------------------------------
# Which provider to use: anthropic, mistral, openai, gemini,
#   ollama, lmstudio, vllm, tgi
LLM_PROVIDER=mistral

# Cloud providers — set the key for the provider you chose above.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

MISTRAL_API_KEY=your-mistral-api-key
MISTRAL_MODEL=codestral-latest

OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-1.5-pro

# Local providers — set the base URL for the provider you chose.
# Keys are optional for local servers.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=codellama

LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_MODEL=qwen2.5-coder

VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=codellama

TGI_BASE_URL=http://localhost:8080
TGI_MODEL=codellama

# LLM gateway tuning
LLM_MAX_TOKENS=4096
LLM_TIMEOUT_SECONDS=120
LLM_MAX_ATTEMPTS=3

# ---- GitHub ------------------------------------------------
GITHUB_TOKEN=ghp_...
# Repair runs publish to the submitted checkout's GitHub origin and default branch.
# These legacy values are only used by standalone create_pr callers.
GITHUB_REPO_OWNER=
GITHUB_REPO_NAME=
# true = no push or PR; false = publish using the token's repository permissions
GITHUB_DRY_RUN=true

# ---- Redis -------------------------------------------------
REDIS_URL=redis://localhost:6379/0

# ---- CORS --------------------------------------------------
# Browser origins allowed to call the API (comma-separated).
# Must include the frontend dev server origin.
# For Railway: add your deployed frontend URL here.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Pipeline Tuning --------------------------------------
MAX_RETRIES=3
MUTMUT_TIMEOUT_SECONDS=60

# ---- Repository Intelligence (A0.5) -----------------------
REPOSITORY_INTELLIGENCE_ENABLED=true
KNOWLEDGE_GRAPH_ENABLED=true
REPAIR_MEMORY_ENABLED=true

# ---- Context Engineering (A5.5) ----------------------------
CONTEXT_ENGINEERING_ENABLED=true
CONTEXT_BUDGET_CHARS=4000

# ---- Environment Precheck (A0.7) --------------------------
ENVIRONMENT_PRECHECK_ENABLED=true
ENVIRONMENT_PROBE_TIMEOUT=30

# ---- Semantic Intent Graph (A1) ----------------------------
ROLE_CONFIDENCE_THRESHOLD=0.85
ROLE_HIGH_CONFIDENCE_THRESHOLD=0.95
SIG_CACHE_ENABLED=true
SIG_CACHE_TTL_SECONDS=604800

# ---- Security Pipeline (Phase 5) --------------------------
SECURITY_ENABLED=true
SECURITY_DEFAULT_CLASSIFICATION=PRIVATE
SECURITY_FAIL_CLOSED=true

# ---- Learning (Phase 6) -----------------------------------
LEARNING_ENABLED=true
LEARNING_ORGANIZATION_ID=default

# ---- Sarvam AI Speech-to-Text -----------------------------
# Backend-only, never exposed to frontend.
# Obtain your key from https://app.sarvam.ai
SARVAM_API_KEY=your-sarvam-api-key
